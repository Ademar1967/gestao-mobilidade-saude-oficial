# Copie este arquivo para .env e preencha os valores reais.
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,transporte-de-enfermos.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://localhost,https://127.0.0.1,https://transporte-de-enfermos.onrender.com
SESSION_COOKIE_AGE=28800
ALLOW_SQLITE_FALLBACK=0
STRICT_DATABASE_URL=1
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gestao_mobilidade_saude
DRF_THROTTLE_ANON=30/min
DRF_THROTTLE_USER=300/min
DRF_THROTTLE_TOKEN_OBTAIN=5/min
DRF_THROTTLE_TOKEN_REFRESH=15/min
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW=900
TWILIO_AUTH_TOKEN=defina-o-token-real-do-twilio-em-producao
